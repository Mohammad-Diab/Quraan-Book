<Window x:Class="Choose"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="اختيار سورة" Height="125" Width="324" ResizeMode="NoResize" FlowDirection="RightToLeft" Loaded="Window_Loaded_1" WindowStartupLocation="CenterScreen">
    <Grid>
        <Button x:Name="_Save" Content="موافق" HorizontalAlignment="Right" Margin="0,0,90,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Height="25" Click="Save_Setting"/>
        <Button x:Name="_Cancel" Content="الغاء" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Click="Cancel" Height="25"/>
        <ComboBox x:Name="ComboBox1" HorizontalAlignment="Right" Height="25" Margin="0,14,50,0" VerticalAlignment="Top" Width="140"/>
        <TextBlock HorizontalAlignment="Left" Margin="18,14,0,0" TextWrapping="Wrap" Text="اختيار سورة:" VerticalAlignment="Top" FontSize="16"/>
    </Grid>
</Window>
