<Window x:Class="Copy"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="نسخ" Height="176" Width="250" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FlowDirection="RightToLeft">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo/>
    </Window.TaskbarItemInfo>
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="White" Offset="1" />
            <GradientStop Color="LightSkyBlue" Offset="0" />
            <GradientStop Color="Azure" Offset="0.605" />
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="114*" />
            <ColumnDefinition Width="49*" />
            <ColumnDefinition Width="65*" />
        </Grid.ColumnDefinitions>
        <ComboBox Height="23" Margin="38,12,8,0" Name="ComboBox1" VerticalAlignment="Top" TabIndex="1" Grid.ColumnSpan="2" Background="{x:Null}" />
        <ComboBox Height="23" Margin="5,12,7,0" Name="ComboBox2" VerticalAlignment="Top" Grid.Column="2" Background="{x:Null}" TabIndex="2" />
        <ComboBox Height="23" Margin="38,52,8,0" Name="ComboBox3" VerticalAlignment="Top" Background="{x:Null}" TabIndex="3" Grid.ColumnSpan="2" />
        <ComboBox Height="23" Margin="5,52,7,0" Name="ComboBox4" VerticalAlignment="Top" Grid.Column="2" Background="{x:Null}" TabIndex="4" />
        <Label Content="من:" Height="28" HorizontalAlignment="Left" Name="Label1" VerticalAlignment="Top" Margin="4,10,0,0" TabIndex="8" />
        <Label Content="الى:" Height="28" HorizontalAlignment="Left" Margin="4,50,0,0" Name="Label2" VerticalAlignment="Top" TabIndex="9" />
        <Button Content="انسخ" Margin="20,107,15,9" Name="Button1" Background="{x:Null}" TabIndex="6" />
        <ProgressBar Height="18" Margin="91,0,34,35" Name="ProgressBar1" VerticalAlignment="Bottom" Visibility="Hidden" Background="{x:Null}" TabIndex="7" Grid.ColumnSpan="3" />
        <CheckBox Content="بدون حركات" Height="Auto" HorizontalAlignment="Left" Margin="10,85,0,0" Name="CheckBox1" VerticalAlignment="Top" Background="{x:Null}" TabIndex="5" IsEnabled="True" />
        <Button Background="{x:Null}" Content="حفظ إلى ملف" Margin="15,107,18,9" Name="Button2" TabIndex="6" Grid.ColumnSpan="2" Grid.Column="1" />
        <WindowsFormsHost Height="19" HorizontalAlignment="Left" Margin="38,35,0,0" Name="WindowsFormsHost1" VerticalAlignment="Top" Width="19" Visibility="Hidden" />
    </Grid>
</Window>
