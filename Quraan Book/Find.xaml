<Window x:Name="find_window" x:Class="Quraan_Book.Find"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="بحث" Height="500" Width="430" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" MinWidth="430" MinHeight="300" Loaded="Window_Loaded" Icon="Images/Find.png" PreviewKeyUp="Window_PreviewKeyUp_1"  FontSize="14" SizeChanged="Window_SizeChanged" Closed="find_window_Closed">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo/>
    </Window.TaskbarItemInfo>
    <Grid>
        <Grid Height="25" Margin="0,0,0,0" VerticalAlignment="Bottom">
            <Grid.Background>
                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                    <GradientStop Color="Azure" Offset="0" />
                    <GradientStop Color="White" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>
        <TextBlock Text="كلمة البحث:" HorizontalAlignment="Left" Margin="10,11,0,0" VerticalAlignment="Top"/>
        <TextBlock Text="بحث في:" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="Search_Word" Language="ar-sy" Margin="85,10,85,0" VerticalAlignment="Top" Background="{x:Null}" ToolTip="يمكنك البحث عن أكثر من كلمة واحدة وذلك باستخدام المعاملين '&amp;' و '|':&#xA;باستخدام المعامل '&amp;' سيتم البحث عن آيات تحوي جميع الكلمات المدخلة معا.&#xA;بينما باستخدام المعامل '|' سيتم البحث عن آيات تحوي إحدى الكلمات المدخلة على الأقل." AutoWordSelection="True"/>
        <ListBox x:Name="Suras_List" Margin="85,40,85,0" VerticalAlignment="Top" Background="{x:Null}" Height="95" />
        <CheckBox x:Name="Ignore_Hamza" Content="تجاهل الفروق بين الهمزات" HorizontalAlignment="Left" Margin="10,140,0,0" VerticalAlignment="Top" Background="{x:Null}" Click="CheckBox1_Click" ToolTip="أ = إ = آ" FontSize="12"/>
        <CheckBox x:Name="Full_Word" Content="بحث عن كلمة كاملة فقط" HorizontalAlignment="Left" Margin="10,160,0,0" VerticalAlignment="Top" Background="{x:Null}" Click="CheckBox2_Click" FontSize="12"/>
        <CheckBox x:Name="Ignore_Accent" Content="تجاهل الحركات" HorizontalAlignment="Left" Margin="180,150,0,0" VerticalAlignment="Top" IsChecked="True" Background="{x:Null}" Click="CheckBox3_Click" IsEnabled="False" FontSize="12"/>
        <TextBlock Text="نتائج البحث:" HorizontalAlignment="Left" Margin="5,182,0,0" VerticalAlignment="Top" FontSize="12"/>
        <ListView x:Name="Search_Results" Margin="5,200,5,25" Background="{x:Null}" SelectionChanged="ListBox1_SelectionChanged" SelectionMode="Single"/>
        <TextBlock Margin="5,0,0,5" VerticalAlignment="Bottom" HorizontalAlignment="Left">
            <Run Text="اسم السورة: " FontSize="12"/>
            <Run x:Name="Sura_Name" Foreground="RoyalBlue"/>
        </TextBlock>
        <TextBlock Margin="133,0,0,5" VerticalAlignment="Bottom" HorizontalAlignment="Left">
            <Run Text="رقم الآية: " FontSize="12"/>
            <Run x:Name="Aya_Number" Foreground="RoyalBlue"/>
        </TextBlock>
        <TextBlock Margin="0,0,5,5" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Run Text="عدد النتائج: " FontSize="12"/>
            <Run x:Name="Result_Number" Foreground="RoyalBlue"/>
        </TextBlock>
        <TextBlock Margin="0,0,113,5" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Run Text="عدد الآيات: " FontSize="12"/>
            <Run x:Name="Ayat_Number" Foreground="RoyalBlue"/>
        </TextBlock>
        <Button x:Name="Search" IsDefault="True" Content="ابحث" Height="23" HorizontalAlignment="Right" Margin="0,150,30,0" VerticalAlignment="Top" Width="75" Background="{x:Null}" Click="Search_Click" />
        <Separator Height="2" Margin="15,180,15,0" VerticalAlignment="Top"/>
    </Grid>
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="AliceBlue" Offset="0" />
            <GradientStop Color="White" Offset="0.5" />
        </LinearGradientBrush>
    </Window.Background>
</Window>
