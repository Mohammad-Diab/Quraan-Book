<Window x:Class="Fonts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fonts" FlowDirection="RightToLeft" Height="200" Width="360" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FontSize="14" Loaded="Window_Loaded_1">
    <Grid>
        <ComboBox x:Name="FontsNames" HorizontalAlignment="Left" Margin="109,10,0,0" VerticalAlignment="Top" Width="140"/>
        <TextBlock HorizontalAlignment="Left" Margin="15,15,0,0" TextWrapping="Wrap" Text="الخط:" VerticalAlignment="Top"/>
        <ComboBox x:Name="FontSizes" HorizontalAlignment="Left" Height="25" Margin="109,50,0,0" VerticalAlignment="Top" Width="140"/>
        <TextBlock HorizontalAlignment="Left" Margin="15,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Span><Run Text="حجم الخط"/></Span><Span><Run FlowDirection="RightToLeft" Language="ar-sa" Text=":"/></Span></TextBlock>
        <ComboBox x:Name="FontColors" HorizontalAlignment="Left" Height="25" Margin="109,90,0,0" VerticalAlignment="Top" Width="140"/>
        <TextBlock HorizontalAlignment="Left" Margin="15,95,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Span><Run Text="لون الخط"/></Span><Span><Run FlowDirection="RightToLeft" Language="ar-sa" Text=":"/></Span></TextBlock>
        <Button x:Name="_Save" Content="موافق" HorizontalAlignment="Right" Margin="0,0,90,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Height="25" Click="Save_Setting" FontSize="12"/>
        <Button x:Name="_Cancel" Content="الغاء" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Click="Cancel" Height="25" FontSize="12"/>
    </Grid>
</Window>
