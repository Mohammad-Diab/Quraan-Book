<Window x:Class="Quraan_Book.about"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عن" Height="285" Width="391" ResizeMode="NoResize" FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen" Background="White" Icon="Images/about.png" PreviewKeyUp="Window_PreviewKeyUp_1">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Image Margin="129,10,128,0" Height="128" VerticalAlignment="Top" Source="Images/Icon.png"/>
        <Label Content="Dr.Mohammad@outlook.com " Margin="84,0,0,43" VerticalAlignment="Bottom" FontSize="14" FontFamily="Segoe Print" Height="35" Foreground="Red" HorizontalAlignment="Left"/>
        <TextBlock Text="المصحف الالكتروني 2 (APPS PREVIEW)" Margin="78,135,0,0" VerticalAlignment="Top" FontSize="14" HorizontalAlignment="Left">
            <TextBlock.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                    <GradientStop Color="#FF00B9FF" Offset="1"/>
                    <GradientStop Color="Lime"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>
        <Image HorizontalAlignment="Left" Margin="15,0,0,20" Width="59" Height="77" VerticalAlignment="Bottom" Source="xbill.png" FlowDirection="LeftToRight"/>
        <Button x:Name="Closes" Content="أغلق" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="90" Background="{x:Null}" Height="25" Click="Close_Click"/>
    </Grid>
</Window>
