<Window x:Class="Quraan_Book.Copy"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="نسخ" Height="330" Width="331" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Loaded="Window_Loaded_1" Icon="Images/copy.png" PreviewKeyUp="Window_PreviewKeyUp_1" Language="ar-sy" ResizeMode="NoResize">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="White" Offset="1" />
            <GradientStop Color="Azure" Offset="0.6" />
            <GradientStop Color="LightGoldenrodYellow" Offset="0" />
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <ListView x:Name="Sura" Margin="10,10,0,70" Background="{x:Null}" HorizontalAlignment="Left" Width="130" SelectionChanged="Sura_SelectionChanged"/>
        <ListView x:Name="Aya" Margin="0,10,10,70" TabIndex="1" Background="{x:Null}" HorizontalAlignment="Right" Width="155"/>
        <CheckBox x:Name="Without_Accent" Content="بدون حركات" HorizontalAlignment="Left" Margin="10,0,0,50" VerticalAlignment="Bottom" Background="{x:Null}"/>
        <Button Content="حفظ إلى ملف" Background="{x:Null}" Margin="10,0,0,10" HorizontalAlignment="Left" Width="140" Height="25" VerticalAlignment="Bottom" Click="Save_to_File_Click" />
        <Button Content="انسخ الى الحافظة" Margin="0,0,10,10" Background="{x:Null}" HorizontalAlignment="Right" Width="140" Height="25" VerticalAlignment="Bottom" Click="Copy_to_Clipboard_Click" />
    </Grid>
</Window>

