<Window x:Class="Quraan_Book.RTF_Viewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عارض مستندات RTF" Height="365" Width="600" FlowDirection="RightToLeft" Loaded="Window_Loaded_1" Icon="Images/rtf_viewer.png">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo/>
    </Window.TaskbarItemInfo>
    <Grid>
        <RichTextBox x:Name="Viewer" AcceptsTab="True" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"/>
    </Grid>
</Window>
