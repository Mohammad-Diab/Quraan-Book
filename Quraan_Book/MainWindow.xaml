<Window x:Class="Quraan_Book.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المصحف الالكتروني" Height="425" Width="700" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" PreviewKeyUp="Window_PreviewKeyUp" Loaded="Window_Loaded_1" Icon="Images/Small_Icon.png" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown_1">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="AliceBlue" Offset="0" />
            <GradientStop Color="White" Offset="0.268" />
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="47*" />
            <ColumnDefinition Width="645*"/>
        </Grid.ColumnDefinitions>
        <RichTextBox x:Name="Viewer" Grid.ColumnSpan="2" FontSize="22" FontFamily="KacstOne" AcceptsReturn="True" AcceptsTab="True" AutoWordSelection="True" IsReadOnly="True" VerticalScrollBarVisibility="Visible" Margin="0,22,0,0" SelectionBrush="#FFFF8C19">
            <FlowDocument>
                <Paragraph x:Name="Par" TextAlignment="Center" Foreground="SlateGray">
                    <Run x:Name="basmala" FontWeight="Bold" Text="اضغط على الزر F2 من لوحة المفاتيح لاختيار سورة &#xD;&#xA;أو من خلال القائمة ملف  -&gt;  اختيار سورة" Foreground="RoyalBlue"/>
                    <!--<Run x:Name="surabody" Text=""/>-->
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
        <Menu VerticalAlignment="Top" Background="#FFEFEFF2" Foreground="#FF1E1E1E">
            <MenuItem Header="ملف" Height="22" FontSize="13">
                <MenuItem x:Name="select" Header="اختيار سورة" Click="Choose_Click" InputGestureText="F2"/>
                <Separator/>
                <MenuItem x:Name="find" Header="بحث" Click="Find_Click" InputGestureText="Crtl + F"/>
                <MenuItem x:Name="copy" Header="نسخ" Click="Copy_Click" InputGestureText="F4"/>
                <MenuItem x:Name="print" Header="طباعة" Click="Print_Click" InputGestureText="F4"/>
                <Separator/>
                <MenuItem x:Name="font" Header="الخط" Click="Font_Click" InputGestureText="F5"/>
                <MenuItem x:Name="rtf_viewer" Header="عارض مستندات RTF" Click="rtf_viewer_Click" InputGestureText="F6"/>
                <Separator/>
                <MenuItem x:Name="about" Header="عن" Click="About_Click"/>
                <MenuItem x:Name="help" Header="مساعدة" Click="Help_Click" InputGestureText="F1"/>
                <Separator/>
                <MenuItem x:Name="close" Header="إغلاق" Click="Close_Click" InputGestureText="Alt + F4"/>
            </MenuItem>
        </Menu>
        <Grid Background="#FFEFEFF2" Grid.Column="1" Height="22" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="175"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="s_aya_count" Text="عدد آياتها" FontSize="15" FontWeight="Bold" Grid.Column="2" Margin="0,0,10,0" HorizontalAlignment="Right">
                <TextBlock.Foreground>
                    <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                        <GradientStop Color="Blue" Offset="0.008" />
                        <GradientStop Color="Green" Offset="1" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            <RichTextBox FontSize="15" FontWeight="Bold" Grid.Column="1" Background="{x:Null}" Block.TextAlignment="Center" BorderBrush="{x:Null}" AcceptsReturn="False" PreviewKeyUp="RichTextBox_PreviewKeyUp_1" Margin="60,0,0,0">
                <TextBlock.Foreground>
                    <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                        <GradientStop Color="Blue" Offset="0.008" />
                        <GradientStop Color="Green" Offset="1" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
                <FlowDocument>
                    <Paragraph>
                        <Run x:Name="s_sort" FlowDirection="RightToLeft" Language="ar-sy" Text="" IsEnabled="True"/>
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
            <TextBlock Text="ترتيبها: " VerticalAlignment="Top" FontSize="15" FontWeight="Bold" Height="20" Grid.Column="1" Margin="10,0,0,0" TextAlignment="Center" HorizontalAlignment="Left" Width="46">
                <TextBlock.Foreground>
                    <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                        <GradientStop Color="Blue" Offset="0.008" />
                        <GradientStop Color="Green" Offset="1" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock x:Name="s_name" Text="اسم السورة" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" FontSize="15" FontWeight="Bold" Height="20">
                <TextBlock.Foreground>
                    <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                        <GradientStop Color="Blue" Offset="0.008" />
                        <GradientStop Color="Green" Offset="1" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBox x:Name="Search" Grid.Column="3" Margin="10,0,25,1" FontSize="13" ToolTip="ابحث في السورة الحالية" TextChanged="Search_TextChanged" AutoWordSelection="True" MaxLines="1" Foreground="CornflowerBlue" Height="20" VerticalAlignment="Bottom" PreviewKeyUp="Search_PreviewKeyUp"/>
            <Image Grid.Column="3" HorizontalAlignment="Right" Height="20" Margin="0,0,1,0" VerticalAlignment="Top" Width="20" Source="Images/Find.png"/>
            <Button x:Name="go_pevious" HorizontalAlignment="Right" Width="28" Background="#FFEFEFF2" BorderBrush="{x:Null}" ToolTip="السورة السابقة" Click="go_pevious_Click"/>
            <Button x:Name="go_next" Grid.Column="2" HorizontalAlignment="Left" Width="28" Background="#FFEFEFF2" BorderBrush="{x:Null}" ToolTip="السورة التالية" Click="go_next_Click"/>
        </Grid>
    </Grid>
</Window>
